{
  "name": "sensorenregister",
  "version": "1.3.0",
  "description": "Register met sensoren van en in de gemeente Amsterdam",
  "repository": {
    "type": "git",
    "url": "https://github.com/Amsterdam/register-slimme-apparaten-frontend.git"
  },
  "engines": {
    "npm": ">=12",
    "node": ">=24"
  },
  "author": "Datapunt Amsterdam",
  "license": "MPL-2.0",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@amsterdam/arm-core": "^1.0.0",
    "@amsterdam/asc-assets": "^0.38.0",
    "@amsterdam/asc-ui": "^0.38.0",
    "@amsterdam/react-maps": "^1.1.1",
    "axios": "^1.20.0",
    "fuse.js": "^7.5.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lodash": "^4.18.1",
    "prop-types": "^15.8.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-router-dom": "^6.30.6",
    "styled-components": "^5.3.11",
    "typescript": "^7.0.2",
    "use-debounce": "^10.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^12.1.5",
    "@testing-library/user-event": "^14.6.7",
    "@types/geojson": "^7946.0.16",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/lodash": "^4.17.25",
    "@types/moxios": "^0.4.18",
    "@types/proj4": "^2.19.0",
    "@types/react": "^17.0.88",
    "@types/react-dom": "^17.0.26",
    "@types/styled-components": "^5.1.36",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest-transform-stub": "^2.0.0",
    "jsdom": "^30.1.1",
    "moxios": "^0.4.0",
    "prettier": "^3.9.9",
    "prettier-eslint": "^17.1.2",
    "sass": "^1.105.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "plugin:react/recommended",
      "plugin:react/jsx-runtime"
    ],
    "env": {
      "browser": true,
      "es2020": true,
      "node": true
    },
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "plugins": [
      "vitest"
    ],
    "settings": {
      "react": {
        "version": "detect"
      }
    }
  }
}